{
  "_comment": "PRISMA-LLM Pipeline — Configuration Template. Copy and customise per review topic. See docs/domain_adaptation.md.",
  "_version": "1.0.0",
  "_schema": "https://github.com/elhallani/prisma-llm-pipeline/blob/main/config/schema.json",
  "review": {
    "title": "Your Systematic Review Title",
    "prospero_id": null,
    "pico": {
      "population": "Define your target population vs comparator (e.g. 'AD patients vs healthy controls')",
      "intervention": "Define your intervention or exposure",
      "comparator": "Define your comparator (often = control group)",
      "outcome": "Define your primary outcome",
      "study_design": "e.g. 'Original empirical studies'"
    },
    "year_start": 2018,
    "year_end": 2025,
    "language": "english",
    "_prospero_note": "Optional: add 'CRDxxxxxxxxxxxx' if your review is registered on PROSPERO. Not required for methodology papers."
  },
  "keywords": {
    "_comment": "Group 1 = Population/Condition, Group 2 = Intervention/Modality, Group 3 = Method. Add 5-8 terms per group including synonyms, abbreviations, MeSH equivalents.",
    "g1_population": [
      "term1",
      "synonym1",
      "abbreviation1"
    ],
    "g2_intervention": [
      "term1",
      "synonym1"
    ],
    "g3_method": [
      "term1",
      "synonym1"
    ]
  },
  "boolean_queries": {
    "_comment": "Pre-built Boolean queries per database. Adjust if needed; default = G1 AND G2 AND G3.",
    "openalex": "(g1_terms) AND (g2_terms) AND (g3_terms)",
    "pubmed": "(g1_terms) AND (g2_terms) AND (g3_terms) AND 2018:2025[dp]",
    "scopus": "TITLE-ABS-KEY((g1_terms) AND (g2_terms) AND (g3_terms)) AND PUBYEAR > 2017 AND PUBYEAR < 2026",
    "semantic_scholar": "natural language version with key terms",
    "ieee": "(g1_terms) AND (g2_terms) AND (g3_terms)",
    "springer": "g1_terms (g2_terms) (g3_terms)"
  },
  "databases": {
    "_comment": "Per-database pagination and rate limit settings. Increase pages/max_total for larger searches.",
    "openalex": {
      "enabled": true,
      "pages": 5,
      "per_page": 200,
      "max_total": 1000,
      "rate_limit_ms": 200
    },
    "pubmed": {
      "enabled": true,
      "max_ids": 800,
      "batch_size": 200,
      "rate_limit_ms": 150
    },
    "semantic_scholar": {
      "enabled": true,
      "pages": 5,
      "per_page": 100,
      "max_total": 500,
      "rate_limit_ms": 1200
    },
    "ieee": {
      "enabled": true,
      "pages": 4,
      "per_page": 200,
      "max_total": 800,
      "rate_limit_ms": 300
    },
    "scopus": {
      "enabled": true,
      "pages": 10,
      "per_page": 25,
      "max_total": 250,
      "rate_limit_ms": 250
    },
    "springer": {
      "enabled": true,
      "pages": 12,
      "per_page": 20,
      "max_total": 200,
      "rate_limit_ms": 800
    }
  },
  "deduplication": {
    "level1_doi_exact": true,
    "level2_normalised_title": true,
    "level3_jaccard_trigram": {
      "enabled": true,
      "threshold": 0.85,
      "require_matching_first_author": true
    },
    "level4_author_year_hash": {
      "enabled": true,
      "n_authors": 3,
      "n_title_words": 3
    }
  },
  "layer1_keyword_filter": {
    "_comment": "Layer 1: 3 binary questions. Each question maps to one keyword group.",
    "questions": [
      {
        "id": "q1",
        "keywords_ref": "g1_population",
        "label": "Mentions target population/condition?"
      },
      {
        "id": "q2",
        "keywords_ref": "g2_intervention",
        "label": "Mentions data modality/intervention?"
      },
      {
        "id": "q3",
        "keywords_ref": "g3_method",
        "label": "Mentions AI/computational method?"
      }
    ],
    "decision_rule": {
      "INCLUDE": "all 3 yes",
      "BORDERLINE": "exactly 2 yes",
      "EXCLUDE": "0 or 1 yes"
    },
    "exclude_if_title_contains": [
      "editorial",
      "letter to editor",
      "book review",
      "correction",
      "erratum"
    ]
  },
  "layer2_llm_scoring": {
    "model": "llama-3.3-70b-versatile",
    "provider": "groq",
    "endpoint": "https://api.groq.com/openai/v1/chat/completions",
    "temperature": 0,
    "max_tokens": 300,
    "prompt_file": "colab/prompts/llm_screening_prompt.md",
    "criteria": {
      "P1_population": {
        "description": "Target condition vs comparator",
        "scoring": {
          "0": "absent",
          "1": "yes",
          "2": "diagnostic criteria explicitly reported"
        },
        "mandatory_min": 1
      },
      "I2_intervention": {
        "description": "Specified data modality/intervention present",
        "scoring": {
          "0": "absent",
          "1": "mentioned",
          "2": "acquisition/protocol described"
        },
        "mandatory_min": 1
      },
      "M3_method": {
        "description": "AI/ML technique applied",
        "scoring": {
          "0": "absent",
          "1": "named",
          "2": "architecture and training detailed"
        },
        "mandatory_min": 0
      },
      "O4_originality": {
        "description": "Original empirical study",
        "scoring": {
          "0": "review/editorial",
          "1": "yes",
          "2": "novel experimental design"
        },
        "mandatory_min": 1
      },
      "C5_contribution": {
        "description": "Substantive contribution to target domain",
        "scoring": {
          "0": "off-topic",
          "1": "incremental",
          "2": "significant advancement"
        },
        "mandatory_min": 0
      }
    },
    "inclusion_threshold": 7,
    "sensitivity_thresholds": [
      6,
      7,
      8
    ],
    "double_verification": true
  },
  "layer3_human_review": {
    "blinding": "structural",
    "hidden_columns_until_decision": [
      "filter_llm",
      "raison_llm"
    ],
    "reviewers": [
      "R1",
      "R2"
    ],
    "arbiter": "R3"
  },
  "kappa": {
    "sample_size": 120,
    "stratified": true,
    "random_seed": 42,
    "bootstrap_resamples": 1000,
    "ci_level": 0.95,
    "gap_threshold": 0.05,
    "minimum_acceptable_kappa": 0.6,
    "landis_koch_thresholds": {
      "excellent": 0.81,
      "substantial": 0.61,
      "moderate": 0.41,
      "fair": 0.21,
      "slight": 0.0
    }
  },
  "layer4_pdf_retrieval": {
    "fallback_chain_priority": [
      "unpaywall",
      "pubmed_central",
      "semantic_scholar",
      "arxiv",
      "biorxiv_medrxiv",
      "core",
      "opendoar_1",
      "opendoar_2",
      "springer_link",
      "wiley_open",
      "mdpi",
      "frontiers"
    ],
    "max_retries": 3,
    "timeout_seconds": 30,
    "user_agent": "PRISMA-LLM-Pipeline/1.0 (+https://github.com/elhallani/prisma-llm-pipeline)"
  },
  "layer5_full_text": {
    "exclusion_taxonomy": [
      "not_target_population",
      "not_target_modality",
      "not_original_study",
      "insufficient_methods_reporting",
      "conference_abstract_only",
      "other"
    ],
    "require_dual_review": true,
    "arbitration_on_disagreement": true
  },
  "output": {
    "google_sheet_id": "${GOOGLE_SHEET_ID}",
    "google_sheet_tab": "SCREENED",
    "drive_folder": "/PRISMA",
    "templates_folder": "/PRISMA/templates",
    "log_level": "INFO"
  }
}