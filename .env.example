# ══════════════════════════════════════════════════════════════════
# PRISMA-LLM Pipeline — Environment Variables Template
# ══════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in your own credentials.
# NEVER commit `.env` — it is git-ignored by default.
#
# Get free API keys at:
#   - Groq:            https://console.groq.com/keys
#   - NCBI/PubMed:     https://www.ncbi.nlm.nih.gov/account/settings/
#   - Semantic Scholar: https://www.semanticscholar.org/product/api
#   - IEEE Xplore:     https://developer.ieee.org/
#   - Scopus (Elsevier): https://dev.elsevier.com/
#   - Springer Nature: https://dev.springernature.com/
#
# ══════════════════════════════════════════════════════════════════

# ── LLM Inference (REQUIRED) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Optional: alternative OpenAI-compatible endpoint (local vLLM, Ollama, etc.)
# Leave empty to use Groq default
LLM_BASE_URL=
LLM_MODEL_NAME=llama-3.3-70b-versatile

# ── Database APIs (REQUIRED for Phase 1) ─────────────────────────
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your.email@institution.edu

SPRINGER_API_KEY=your_springer_api_key_here
SPRINGER_OA_API_KEY=your_springer_open_access_key_here

SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

IEEE_API_KEY=your_ieee_xplore_key_here

SCOPUS_API_KEY=your_scopus_elsevier_key_here

# ── Google Sheets (REQUIRED for Phase 3) ─────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=SCREENED

# Path to Google service account JSON (for Colab use auth.authenticate_user())
GOOGLE_CREDENTIALS_JSON=./credentials/service_account.json

# ── Pipeline Configuration ───────────────────────────────────────
ACTIVE_CONFIG=config/config_template.json
RUN_ID=
LOG_LEVEL=INFO

# ── Optional: Unpaywall (PDF retrieval Layer 4) ──────────────────
UNPAYWALL_EMAIL=your.email@institution.edu
